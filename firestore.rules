rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && (
          request.auth.token.email.lower() in [
            "ultimatecoding2@gmail.com",
            "maaaziz5050@gmail.com",
            "allxzy06@gmail.com"
          ]
          || (
            request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
          )
        );
    }

    function isNotBlocked() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked != true
      );
    }

    function isValidScore(val) {
      return val is int && val >= 0 && val <= 100000;
    }

    function isValidCoins(val) {
      return val is int && val >= 0 && val <= 50000;
    }

    function isValidQuotaUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["requests"])
        || (
          request.resource.data.requests is int
          && request.resource.data.requests >= 0
          && request.resource.data.requests <= 40
          && (
            request.resource.data.requests == (resource.data.requests is int ? resource.data.requests : 0) + 1
            || (
              request.resource.data.quotaHourBucket is int
              && (!(resource.data.quotaHourBucket is int) || request.resource.data.quotaHourBucket > resource.data.quotaHourBucket)
              && request.resource.data.requests <= 1
            )
          )
        );
    }

    // Koleksi admin
    match /admins/{adminEmail} {
      allow get: if isSignedIn()
        && request.auth.token.email is string
        && (request.auth.token.email.lower() == adminEmail || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // Koleksi pengguna
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.isBlocked == false
        && request.resource.data.blockReason == ""
        && request.resource.data.requests == 0
        && request.resource.data.bestQuizScore == 0;

      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && resource.data.isBlocked != true
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "uid", "email", "isBlocked", "blockReason"
        ])
        && isValidQuotaUpdate()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["bestQuizScore"])
          || (
            isValidScore(request.resource.data.bestQuizScore)
            && request.resource.data.bestQuizScore >= (resource.data.bestQuizScore is int ? resource.data.bestQuizScore : 0)
            && (request.resource.data.bestQuizScore - (resource.data.bestQuizScore is int ? resource.data.bestQuizScore : 0)) <= 25000
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["coins"])
          || (
            isValidCoins(request.resource.data.coins)
            && (request.resource.data.coins - (resource.data.coins is int ? resource.data.coins : 0)) <= 2000
          )
        )
      );

      allow delete: if isAdmin();
    }

    // Ruang Arena Game (1 sampai 50 pemain, 3 sampai 10 stage, TTL expiresAt)
    match /mabar_rooms/{roomCode} {
      allow read: if isSignedIn() && isNotBlocked();

      allow create: if isSignedIn()
        && isNotBlocked()
        && request.resource.data.code == roomCode
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.maxPlayers is int
        && request.resource.data.maxPlayers >= 1
        && request.resource.data.maxPlayers <= 50
        && request.resource.data.stageCount is int
        && request.resource.data.stageCount >= 3
        && request.resource.data.stageCount <= 10
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount >= 0
        && request.resource.data.playerCount <= 1
        && request.resource.data.status == "waiting"
        && request.resource.data.expiresAt is timestamp;

      allow update: if isAdmin() || (
        isSignedIn()
        && isNotBlocked()
        && request.resource.data.code == resource.data.code
        && request.resource.data.maxPlayers is int
        && request.resource.data.maxPlayers >= 1
        && request.resource.data.maxPlayers <= 50
        && request.resource.data.stageCount is int
        && request.resource.data.stageCount >= 3
        && request.resource.data.stageCount <= 10
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount >= 0
        && request.resource.data.playerCount <= request.resource.data.maxPlayers
        && (
          (
            resource.data.hostUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "gameType", "difficulty", "subject", "stageCount", "questionsPerStage",
              "hostMode", "teams", "missionData", "seed", "maxPlayers", "playerCount",
              "hostUid", "hostName", "startedAt", "updatedAt", "expiresAt"
            ])
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "playerCount", "updatedAt", "expiresAt"
            ])
            && request.resource.data.maxPlayers == resource.data.maxPlayers
            && (
              request.resource.data.playerCount == resource.data.playerCount + 1
              || request.resource.data.playerCount == resource.data.playerCount - 1
            )
          )
        )
      );

      allow delete: if isAdmin() || (
        isSignedIn()
        && resource.data.hostUid == request.auth.uid
      );

      match /players/{playerId} {
        allow read: if isSignedIn() && isNotBlocked();

        allow create: if isAdmin()
          || (
            isSignedIn()
            && isNotBlocked()
            && request.auth.uid == playerId
            && request.resource.data.uid == playerId
            && isValidScore(request.resource.data.score)
          );

        allow update: if isAdmin()
          || (
            isSignedIn()
            && isNotBlocked()
            && get(/databases/$(database)/documents/mabar_rooms/$(roomCode)).data.hostUid == request.auth.uid
          )
          || (
            isSignedIn()
            && isNotBlocked()
            && request.auth.uid == playerId
            && request.resource.data.uid == playerId
            && isValidScore(request.resource.data.score)
          );

        allow delete: if isAdmin()
          || (isSignedIn() && request.auth.uid == playerId)
          || (isSignedIn() && get(/databases/$(database)/documents/mabar_rooms/$(roomCode)).data.hostUid == request.auth.uid);
      }
    }

    // Log aktivitas administrator
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
